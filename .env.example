# REMS configuration. Copy this file to .env and fill in the values.
# See "Configuration" in README.md for every setting.

# Required: signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# Enable debug mode for local development only. Remove or set to 0 in production.
# (FLASK_ENV is deprecated in Flask 2.x)
FLASK_DEBUG=1

# Database (optional - defaults to SQLite at instance/physdb.db)
# Leave unset to use SQLite, the supported database. Other databases are untested
# and need their driver added to requirements.txt, e.g.:
# DATABASE_URL=postgresql+psycopg://username:password@localhost/physdb

# Servers behind HTTPS. Render sets both automatically; on any other host, set them yourself.
# Send the session cookie only over HTTPS. Leave unset for plain-HTTP local dev.
# SESSION_COOKIE_SECURE=1
# Number of reverse proxies in front of the app (e.g. 1 for NGINX). Leave unset
# when nothing sits in front, or clients could spoof their IP address.
# TRUSTED_PROXY_COUNT=1
